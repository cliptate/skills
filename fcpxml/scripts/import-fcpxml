#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

sys.dont_write_bytecode = True

from _fcpxml_support import (
    ImportDispatchError,
    dispatch_to_final_cut,
    prepare_import_artifact,
    resolve_final_cut_target,
    resolve_target_library,
    validate_artifact,
)


def emit(payload: dict[str, object]) -> None:
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Validate an FCPXML artifact and hand it to Final Cut Pro for import."
        )
    )
    parser.add_argument("input", help="Input .fcpxml file or .fcpxmld bundle.")
    parser.add_argument("--dtd", help="Explicit authoritative matching DTD path.")
    parser.add_argument(
        "--bundle-id",
        help="Explicit supported Final Cut Pro bundle identifier.",
    )
    parser.add_argument(
        "--library-location",
        help=(
            "Target .fcpbundle path or file URL. When omitted, use an existing "
            "exported Library location from the FCPXML."
        ),
    )
    parser.add_argument(
        "--import-copy",
        help=(
            "Path for the generated Import-ready .fcpxml or .fcpxmld copy. "
            "Defaults to a unique temporary location."
        ),
    )
    media_group = parser.add_mutually_exclusive_group()
    media_group.add_argument(
        "--copy-assets",
        action="store_true",
        help="Copy referenced media into the Target Library.",
    )
    media_group.add_argument(
        "--leave-assets-in-place",
        action="store_true",
        help="Keep referenced media at its current location.",
    )
    parser.add_argument(
        "--show-warnings",
        action="store_true",
        help="Allow Final Cut Pro to show non-fatal import warnings.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "Prepare and validate the Import-ready artifact without sending the "
            "Open Document event."
        ),
    )
    arguments = parser.parse_args()

    report = validate_artifact(arguments.input, arguments.dtd)
    validation = report.as_dict(command="fcpxml.validate")
    if not report.valid or report.artifact is None:
        emit(
            {
                "schemaVersion": 1,
                "command": "fcpxml.import",
                "status": "failed" if report.status == "invalid" else "incomplete",
                "error": {
                    "code": "invalid_import_artifact"
                    if report.status == "invalid"
                    else "validation_incomplete",
                    "message": (
                        "FCPXML validation failed before Final Cut Pro handoff"
                        if report.status == "invalid"
                        else "FCPXML validation could not be completed"
                    ),
                },
                "validation": validation,
            }
        )
        return report.exit_status

    if arguments.copy_assets:
        copy_assets: bool | None = True
    elif arguments.leave_assets_in_place:
        copy_assets = False
    else:
        copy_assets = None

    try:
        target = resolve_final_cut_target(arguments.bundle_id)
        target_library = resolve_target_library(
            report.artifact,
            arguments.library_location,
        )
        prepared = prepare_import_artifact(
            report.artifact,
            target_library,
            suppress_warnings=not arguments.show_warnings,
            copy_assets=copy_assets,
            output_path=arguments.import_copy,
        )
        import_report = validate_artifact(prepared.artifact.artifact_path, arguments.dtd)
        import_validation = import_report.as_dict(command="fcpxml.validate")
        if not import_report.valid or import_report.artifact is None:
            emit(
                {
                    "schemaVersion": 1,
                    "command": "fcpxml.import",
                    "status": (
                        "failed" if import_report.status == "invalid" else "incomplete"
                    ),
                    "error": {
                        "code": "invalid_import_ready_artifact"
                        if import_report.status == "invalid"
                        else "import_ready_validation_incomplete",
                        "message": (
                            "Import-ready FCPXML validation failed"
                            if import_report.status == "invalid"
                            else "Import-ready FCPXML validation could not be completed"
                        ),
                    },
                    "sourceArtifact": str(report.artifact.artifact_path),
                    "importArtifact": str(prepared.artifact.artifact_path),
                    "validation": validation,
                    "importValidation": import_validation,
                }
            )
            return import_report.exit_status
        if arguments.dry_run:
            status = "ready"
        else:
            dispatch_to_final_cut(prepared.artifact, target)
            status = "dispatch_accepted"
    except ImportDispatchError as error:
        emit(
            {
                "schemaVersion": 1,
                "command": "fcpxml.import",
                "status": "failed",
                "error": {"code": error.code, "message": str(error)},
                "validation": validation,
            }
        )
        return 69

    emit(
        {
            "schemaVersion": 1,
            "command": "fcpxml.import",
            "status": status,
            "dispatchAccepted": not arguments.dry_run,
            "dispatchMethod": "open-document-apple-event",
            "sourceArtifact": str(report.artifact.artifact_path),
            "sourceXML": str(report.artifact.xml_path),
            "importArtifact": str(prepared.artifact.artifact_path),
            "importXML": str(prepared.artifact.xml_path),
            "fcpxmlVersion": prepared.artifact.version,
            "targetLibrary": {
                "path": str(prepared.target_library.path),
                "location": prepared.target_library.location,
                "source": prepared.target_library.source,
                "existed": prepared.target_library.existed,
            },
            "importOptions": {
                "suppressWarnings": prepared.suppress_warnings,
                "copyAssets": prepared.copy_assets,
            },
            "targetBundleIdentifier": target.bundle_identifier,
            "targetApplication": (
                str(target.application_path)
                if target.application_path is not None
                else None
            ),
            "validation": validation,
            "importValidation": import_validation,
        }
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
