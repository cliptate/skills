#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

sys.dont_write_bytecode = True

from _fcpxml_support import validate_artifact


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Validate FCPXML without modifying the source artifact."
    )
    parser.add_argument("input", help="Input .fcpxml file or .fcpxmld bundle.")
    parser.add_argument("--dtd", help="Explicit authoritative matching DTD path.")
    arguments = parser.parse_args()

    report = validate_artifact(arguments.input, arguments.dtd)
    print(
        json.dumps(
            report.as_dict(),
            ensure_ascii=False,
            separators=(",", ":"),
        )
    )
    return report.exit_status


if __name__ == "__main__":
    sys.exit(main())
