#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys

sys.dont_write_bytecode = True

from _fcpxml_support import (
    PortablePackageError,
    PortablePackageValidationError,
    create_portable_bundle,
    validate_artifact,
)


def emit(payload: dict[str, object]) -> None:
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Create a self-contained .fcpxmld bundle with byte-identical local "
            "media and relative media-rep URLs."
        )
    )
    parser.add_argument("input", help="Input .fcpxml file or .fcpxmld bundle.")
    parser.add_argument(
        "--output",
        required=True,
        help="New portable .fcpxmld bundle path in an ignored output directory.",
    )
    parser.add_argument("--dtd", help="Explicit authoritative matching DTD path.")
    arguments = parser.parse_args()

    source_report = validate_artifact(arguments.input, arguments.dtd)
    source_validation = source_report.as_dict(command="fcpxml.validate")
    if not source_report.valid or source_report.artifact is None:
        emit(
            {
                "schemaVersion": 1,
                "command": "fcpxml.package-portable",
                "status": (
                    "failed" if source_report.status == "invalid" else "incomplete"
                ),
                "error": {
                    "code": (
                        "invalid_source_artifact"
                        if source_report.status == "invalid"
                        else "source_validation_incomplete"
                    ),
                    "message": (
                        "Source FCPXML validation failed before portable packaging"
                        if source_report.status == "invalid"
                        else "Source FCPXML validation could not be completed"
                    ),
                },
                "sourceValidation": source_validation,
            }
        )
        return source_report.exit_status

    try:
        package = create_portable_bundle(
            source_report.artifact,
            arguments.output,
            arguments.dtd,
        )
    except PortablePackageValidationError as error:
        output_validation = error.report.as_dict(command="fcpxml.validate")
        emit(
            {
                "schemaVersion": 1,
                "command": "fcpxml.package-portable",
                "status": (
                    "failed" if error.report.status == "invalid" else "incomplete"
                ),
                "error": {"code": error.code, "message": str(error)},
                "sourceValidation": source_validation,
                "outputValidation": output_validation,
            }
        )
        return error.report.exit_status
    except PortablePackageError as error:
        emit(
            {
                "schemaVersion": 1,
                "command": "fcpxml.package-portable",
                "status": "failed",
                "error": {"code": error.code, "message": str(error)},
                "sourceValidation": source_validation,
            }
        )
        return 65

    bundled_files = {value.bundled_path for value in package.media}
    source_media_bytes = sum(value.size for value in package.media)
    bundled_media_bytes = sum(value.stat().st_size for value in bundled_files)
    emit(
        {
            "schemaVersion": 1,
            "command": "fcpxml.package-portable",
            "status": "created",
            "sourceArtifact": str(package.source.artifact_path),
            "outputArtifact": str(package.artifact.artifact_path),
            "outputXML": str(package.artifact.xml_path),
            "fcpxmlVersion": package.artifact.version,
            "mediaSourceCount": len(package.media),
            "bundledMediaFileCount": len(bundled_files),
            "sourceMediaBytes": source_media_bytes,
            "mediaBytes": bundled_media_bytes,
            "bundleBytes": package.bundle_size,
            "media": [value.as_dict() for value in package.media],
            "sourceValidation": source_validation,
            "outputValidation": package.validation.as_dict(command="fcpxml.validate"),
        }
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
